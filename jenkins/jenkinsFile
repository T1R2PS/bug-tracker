pipeline {

    // Defines where the pipeline will run.
    // "any" means Jenkins can use any available agent (worker node).
    agent any

    // The pipeline is divided into stages.
    // Each stage represents one phase of the CI/CD process.
    stages {

        // This stage runs backend and frontend tests simultaneously.
        // Running in parallel reduces the total build time.
        stage('Execute Unit test parallel') {

            parallel {

                // ==========================
                // Backend Unit Tests
                // ==========================
                stage('Unit Test - Backend') {

                    // Override the global agent for this stage.
                    // Instead of running directly on Jenkins,
                    // run inside a Docker container.
                    agent {
                        docker {

                            // Docker image containing Go 1.21
                            // and the go-junit-report tool.
                            // Using Docker ensures everyone has
                            // the same build environment.
                            image 'snakee/golang-junit:1.21'

                            // Reuse the existing Jenkins workspace.
                            // Prevents Jenkins from checking out the
                            // repository again inside the container.
                            reuseNode true
                        }
                    }

                    steps {

                        // Change the working directory.
                        // The Go project (go.mod) is located here,
                        // so all Go commands must run inside it.
                        dir('bugtracker-backend') {

                            // Run all backend unit tests.
                            //
                            // GOCACHE:
                            // Temporary location for compiled packages.
                            //
                            // GOMODCACHE:
                            // Temporary location for downloaded Go modules.
                            //
                            // These locations avoid permission problems
                            // inside the Docker container.
                            //
                            // go test -v ./...
                            // -v      -> verbose output
                            // ./...   -> current package and all subpackages
                            //
                            // go-junit-report converts Go output into
                            // JUnit XML so Jenkins can display test results.
                            sh '''
                                GOCACHE=/tmp/go-build \
                                GOMODCACHE=/tmp/go-mod-cache \
                                go test -v ./... 2>&1 | go-junit-report > test-results.xml
                            '''

                            // Run tests again to generate code coverage.
                            //
                            // coverage.out contains information about
                            // which lines of code were executed.
                            sh '''
                                GOCACHE=/tmp/go-build \
                                GOMODCACHE=/tmp/go-mod-cache \
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                            '''

                            // Convert the coverage file into an HTML report.
                            // This produces coverage.html.
                            sh '''
                                GOCACHE=/tmp/go-build \
                                GOMODCACHE=/tmp/go-mod-cache \
                                go tool cover -html=coverage.out -o coverage.html
                            '''

                            // Create a directory for reports.
                            // "-p" means don't fail if it already exists.
                            sh 'mkdir -p reports'

                            // Move the HTML report into the reports folder.
                            sh 'mv coverage.html reports/'
                        }
                    }

                    // Runs after this stage finishes,
                    // even if tests fail.
                    post {
                        always {

                            // Publish JUnit test results.
                            // Jenkins displays passed/failed tests
                            // and keeps a history across builds.
                            junit 'bugtracker-backend/test-results.xml'

                            // Publish the HTML coverage report.
                            // Makes it accessible directly from Jenkins.
                            publishHTML target: [
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ]
                        }
                    }
                }

                // ==========================
                // Frontend Unit Tests
                // ==========================
                stage('Unit Test - Frontend') {

                    // Run frontend tests inside a Node.js container.
                    agent {
                        docker {

                            // Lightweight Node.js image.
                            image 'node:20-alpine'

                            // Reuse Jenkins workspace.
                            reuseNode true
                        }
                    }

                    steps {

                        // Switch into the frontend project.
                        dir('bugtracker-frontend') {

                            sh '''
                                # Install dependencies exactly as defined
                                # in package-lock.json.
                                # Faster and more reliable than npm install.
                                npm ci

                                # Execute frontend unit tests.
                                npm test

                                # Create reports directory.
                                mkdir -p reports

                                # Move generated coverage folder
                                # into the reports directory.
                                mv coverage reports/
                            '''
                        }
                    }

                    post {
                        always {

                            // Publish frontend JUnit results.
                            junit 'bugtracker-frontend/test-results.xml'

                            // Publish frontend HTML coverage report.
                            publishHTML target: [
                                reportDir: 'bugtracker-frontend/reports/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ]
                        }
                    }
                }
            }
        }

        // ==========================
        // Launch Application
        // ==========================
        stage('Launch Application') {

            // Use a Docker CLI container.
            agent {
                docker {

                    // Image containing the Docker client.
                    image 'docker:27.5.1'

                    reuseNode true

                    // Extra Docker container arguments.
                    //
                    // -v mounts the host Docker socket so the
                    // Docker CLI inside the container can control
                    // Docker running on the Jenkins host.
                    //
                    // -u 0 runs as the root user to avoid
                    // permission issues with Docker.
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }

            steps {

                // Build images if necessary and start all services
                // defined in docker-compose.yml.
                //
                // --build  -> rebuild images if needed
                // -d       -> run containers in the background
                sh 'docker compose up --build -d'
            }
        }

        // ==========================
        // Launch API Tests
        // ==========================
        stage('Playwright API Tests'){
            agent{
                docker{
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args'-u 0 --network=host'
                }
            }
            steps{
                dir('tests-api'){

                    sh 'pwd'
                    sh 'ls -la'
                    sh 'ls -la package.json package-lock.json'
                    //Wait for 30 sec util the application is ready
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000' 

                    sh 'npm ci'
                    sh 'npx playwright test'
                }
            }
            post{
                always{
                    junit 'tests-api/test-results/results.xml'
                    publishHTML target: [
                        reportDir: 'tests-api/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'Playwright API Test Report',
                    ]
                }
            }


        }

        // ==========================
        // Launch E2E UI Tests
        // ==========================
        stage('E2E Tests'){
            agent{
                docker{
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args'-u 0 --network=host'
                }
            }
            steps{
                dir('tests-e2e'){
                    sh 'pwd'
                    sh 'ls -la'
                    sh 'ls -la package.json package-lock.json'
                    //Wait for 30 sec util the application is ready
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000' 

                    sh 'npm ci'
                    sh 'npx playwright test'

                }
            }
        }

    }

    // Runs after the entire pipeline finishes,
    // regardless of success or failure.
    post {
        always {

            // Delete the Jenkins workspace.
            //
            // Prevents old files from affecting future builds
            // and frees disk space.
            cleanWs()
        }
    }
}